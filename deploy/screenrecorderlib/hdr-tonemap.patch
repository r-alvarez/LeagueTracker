+void WindowsGraphicsCapture::ConfigureFramePoolFormat(_In_ RECORDING_SOURCE_BASE &recordingSource)
+{
+	m_FramePoolFormat = winrt::DirectXPixelFormat::B8G8R8A8UIntNormalized;
+	m_DisplayHdr = {};
+	if (!m_ToneMapper || !IsHdrToneMappingEnabled()) {
+		return;
+	}
+	HMONITOR monitor = nullptr;
+	if (recordingSource.Type == RecordingSourceType::Window) {
+		monitor = MonitorFromWindow(recordingSource.SourceWindow, MONITOR_DEFAULTTONEAREST);
+	}
+	else {
+		CComPtr<IDXGIOutput> output = nullptr;
+		if (SUCCEEDED(GetOutputForDeviceName(recordingSource.SourcePath, &output)) && output) {
+			DXGI_OUTPUT_DESC outputDesc{};
+			if (SUCCEEDED(output->GetDesc(&outputDesc))) {
+				monitor = outputDesc.Monitor;
+			}
+		}
+	}
+	if (!monitor) {
+		return;
+	}
+	m_DisplayHdr = GetDisplayHdrInfo(monitor);
+	if (m_DisplayHdr.IsHdr) {
+		// An 8-bit pool on an HDR desktop hands back the clamp of scRGB, not
+		// the picture: SDR white boosted, HDR highlights clipped. FP16 keeps
+		// the real values so the tone-mapper can produce an SDR frame.
+		m_FramePoolFormat = winrt::DirectXPixelFormat::R16G16B16A16Float;
+		LOG_INFO(L"HDR display: capturing scRGB FP16 and tone-mapping to SDR (SDR white %.0f nits, peak %.0f nits)", m_DisplayHdr.SdrWhiteNits, m_DisplayHdr.MaxLuminanceNits);
+	}
+}
