diff -ruN -x '*.user' -x .vs a/ScreenRecorderLibNative/HdrToneMap.cpp b/ScreenRecorderLibNative/HdrToneMap.cpp
--- a/ScreenRecorderLibNative/HdrToneMap.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/ScreenRecorderLibNative/HdrToneMap.cpp	2026-08-18 07:32:55.799446100 +0100
@@ -0,0 +1,268 @@
+#include "HdrToneMap.h"
+#include "CommonTypes.h"
+#include "DX.util.h"
+#include "Cleanup.h"
+#include "Util.h"
+#include "VertexShader.h"
+#include "HdrToneMapShader.h"
+#include <atlbase.h>
+#include <comdef.h>
+#include <vector>
+#include <string>
+
+using namespace DirectX;
+
+namespace
+{
+	// SDRWhiteLevel is in units of 1/1000 of 80 nits (the scRGB reference).
+	bool TryGetSdrWhiteNits(_In_ const WCHAR *gdiDeviceName, _Out_ float *pNits)
+	{
+		*pNits = 80.0f;
+		UINT32 pathCount = 0, modeCount = 0;
+		if (GetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &pathCount, &modeCount) != ERROR_SUCCESS) {
+			return false;
+		}
+		std::vector<DISPLAYCONFIG_PATH_INFO> paths(pathCount);
+		std::vector<DISPLAYCONFIG_MODE_INFO> modes(modeCount);
+		if (QueryDisplayConfig(QDC_ONLY_ACTIVE_PATHS, &pathCount, paths.data(), &modeCount, modes.data(), nullptr) != ERROR_SUCCESS) {
+			return false;
+		}
+		for (UINT32 i = 0; i < pathCount; i++) {
+			DISPLAYCONFIG_SOURCE_DEVICE_NAME sourceName{};
+			sourceName.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+			sourceName.header.size = sizeof(sourceName);
+			sourceName.header.adapterId = paths[i].sourceInfo.adapterId;
+			sourceName.header.id = paths[i].sourceInfo.id;
+			if (DisplayConfigGetDeviceInfo(&sourceName.header) != ERROR_SUCCESS
+				|| _wcsicmp(sourceName.viewGdiDeviceName, gdiDeviceName) != 0) {
+				continue;
+			}
+			DISPLAYCONFIG_SDR_WHITE_LEVEL whiteLevel{};
+			whiteLevel.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SDR_WHITE_LEVEL;
+			whiteLevel.header.size = sizeof(whiteLevel);
+			whiteLevel.header.adapterId = paths[i].targetInfo.adapterId;
+			whiteLevel.header.id = paths[i].targetInfo.id;
+			if (DisplayConfigGetDeviceInfo(&whiteLevel.header) != ERROR_SUCCESS || whiteLevel.SDRWhiteLevel == 0) {
+				return false;
+			}
+			*pNits = whiteLevel.SDRWhiteLevel / 1000.0f * 80.0f;
+			return true;
+		}
+		return false;
+	}
+}
+
+DISPLAY_HDR_INFO GetDisplayHdrInfo(_In_ HMONITOR monitor)
+{
+	DISPLAY_HDR_INFO info{};
+	CComPtr<IDXGIFactory1> factory;
+	if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))) {
+		return info;
+	}
+	CComPtr<IDXGIAdapter1> adapter;
+	for (UINT a = 0; factory->EnumAdapters1(a, &adapter) != DXGI_ERROR_NOT_FOUND; a++, adapter.Release()) {
+		CComPtr<IDXGIOutput> output;
+		for (UINT o = 0; adapter->EnumOutputs(o, &output) != DXGI_ERROR_NOT_FOUND; o++, output.Release()) {
+			DXGI_OUTPUT_DESC desc{};
+			if (FAILED(output->GetDesc(&desc)) || desc.Monitor != monitor) {
+				continue;
+			}
+			CComPtr<IDXGIOutput6> output6;
+			DXGI_OUTPUT_DESC1 desc1{};
+			if (FAILED(output->QueryInterface(IID_PPV_ARGS(&output6))) || FAILED(output6->GetDesc1(&desc1))) {
+				return info; // pre-1803 DXGI: no HDR desktops either
+			}
+			info.IsHdr = desc1.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+			// Displays that don't advertise a peak (or advertise nonsense) get
+			// HDR1000's; the number only shapes the roll-off, and 1000 nits is
+			// where Windows itself parks unknown panels.
+			info.MaxLuminanceNits = desc1.MaxLuminance >= 100.0f ? desc1.MaxLuminance : 1000.0f;
+			float sdrWhite;
+			if (TryGetSdrWhiteNits(desc.DeviceName, &sdrWhite)) {
+				info.SdrWhiteNits = sdrWhite;
+			}
+			return info;
+		}
+	}
+	return info;
+}
+
+bool IsHdrToneMappingEnabled()
+{
+	WCHAR value[8]{};
+	DWORD length = GetEnvironmentVariableW(L"SCREENRECORDERLIB_HDR_TONEMAP", value, ARRAYSIZE(value));
+	return !(length == 1 && value[0] == L'0');
+}
+
+HdrToneMapper::HdrToneMapper() :
+	m_Device(nullptr),
+	m_DeviceContext(nullptr),
+	m_VertexShader(nullptr),
+	m_PixelShader(nullptr),
+	m_InputLayout(nullptr),
+	m_Sampler(nullptr),
+	m_ParamsBuffer(nullptr),
+	m_SourceCopy(nullptr)
+{
+}
+
+HdrToneMapper::~HdrToneMapper()
+{
+	CleanRefs();
+}
+
+void HdrToneMapper::CleanRefs()
+{
+	SafeRelease(&m_SourceCopy);
+	SafeRelease(&m_ParamsBuffer);
+	SafeRelease(&m_Sampler);
+	SafeRelease(&m_InputLayout);
+	SafeRelease(&m_PixelShader);
+	SafeRelease(&m_VertexShader);
+	SafeRelease(&m_DeviceContext);
+	SafeRelease(&m_Device);
+}
+
+HRESULT HdrToneMapper::Initialize(_In_ ID3D11DeviceContext *pDeviceContext, _In_ ID3D11Device *pDevice)
+{
+	CleanRefs();
+	m_Device = pDevice;
+	m_DeviceContext = pDeviceContext;
+	m_Device->AddRef();
+	m_DeviceContext->AddRef();
+
+	HRESULT hr = m_Device->CreateVertexShader(g_VS, ARRAYSIZE(g_VS), nullptr, &m_VertexShader);
+	RETURN_ON_BAD_HR(hr);
+	D3D11_INPUT_ELEMENT_DESC layout[] =
+	{
+		{ "SV_POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, 0, D3D11_INPUT_PER_VERTEX_DATA, 0 },
+		{ "TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT, 0, 12, D3D11_INPUT_PER_VERTEX_DATA, 0 }
+	};
+	hr = m_Device->CreateInputLayout(layout, ARRAYSIZE(layout), g_VS, ARRAYSIZE(g_VS), &m_InputLayout);
+	RETURN_ON_BAD_HR(hr);
+	hr = m_Device->CreatePixelShader(g_HdrToneMapPS, ARRAYSIZE(g_HdrToneMapPS), nullptr, &m_PixelShader);
+	RETURN_ON_BAD_HR(hr);
+
+	// Point sampling: the quad maps 1:1 onto the destination, so any
+	// filtering would only blur.
+	D3D11_SAMPLER_DESC samplerDesc{};
+	samplerDesc.Filter = D3D11_FILTER_MIN_MAG_MIP_POINT;
+	samplerDesc.AddressU = D3D11_TEXTURE_ADDRESS_CLAMP;
+	samplerDesc.AddressV = D3D11_TEXTURE_ADDRESS_CLAMP;
+	samplerDesc.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+	samplerDesc.ComparisonFunc = D3D11_COMPARISON_NEVER;
+	samplerDesc.MaxLOD = D3D11_FLOAT32_MAX;
+	hr = m_Device->CreateSamplerState(&samplerDesc, &m_Sampler);
+	RETURN_ON_BAD_HR(hr);
+
+	D3D11_BUFFER_DESC paramsDesc{};
+	paramsDesc.Usage = D3D11_USAGE_DEFAULT;
+	paramsDesc.ByteWidth = sizeof(TONEMAP_PARAMS);
+	paramsDesc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+	hr = m_Device->CreateBuffer(&paramsDesc, nullptr, &m_ParamsBuffer);
+	RETURN_ON_BAD_HR(hr);
+	return hr;
+}
+
+HRESULT HdrToneMapper::Convert(_In_ ID3D11Texture2D *pSource, _Inout_ ID3D11Texture2D *pDestination, _In_ D3D11_BOX sourceRegion, _In_ DISPLAY_HDR_INFO display)
+{
+	if (!m_Device) {
+		return E_NOT_VALID_STATE;
+	}
+	UINT width = sourceRegion.right - sourceRegion.left;
+	UINT height = sourceRegion.bottom - sourceRegion.top;
+	if (width == 0 || height == 0) {
+		return S_FALSE;
+	}
+	D3D11_TEXTURE2D_DESC sourceDesc{};
+	pSource->GetDesc(&sourceDesc);
+	// The frame pool's own textures are not guaranteed shader-bindable, so
+	// the region is copied into one that is (a GPU-side copy, no readback).
+	D3D11_TEXTURE2D_DESC copyDesc{};
+	if (m_SourceCopy) {
+		m_SourceCopy->GetDesc(&copyDesc);
+	}
+	if (!m_SourceCopy || copyDesc.Width != width || copyDesc.Height != height || copyDesc.Format != sourceDesc.Format) {
+		SafeRelease(&m_SourceCopy);
+		copyDesc = {};
+		copyDesc.Width = width;
+		copyDesc.Height = height;
+		copyDesc.MipLevels = 1;
+		copyDesc.ArraySize = 1;
+		copyDesc.Format = sourceDesc.Format;
+		copyDesc.SampleDesc.Count = 1;
+		copyDesc.Usage = D3D11_USAGE_DEFAULT;
+		copyDesc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+		HRESULT hr = m_Device->CreateTexture2D(&copyDesc, nullptr, &m_SourceCopy);
+		RETURN_ON_BAD_HR(hr);
+	}
+	m_DeviceContext->CopySubresourceRegion(m_SourceCopy, 0, 0, 0, 0, pSource, 0, &sourceRegion);
+
+	CComPtr<ID3D11ShaderResourceView> srv;
+	D3D11_SHADER_RESOURCE_VIEW_DESC srvDesc{};
+	srvDesc.Format = copyDesc.Format;
+	srvDesc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+	srvDesc.Texture2D.MipLevels = 1;
+	HRESULT hr = m_Device->CreateShaderResourceView(m_SourceCopy, &srvDesc, &srv);
+	RETURN_ON_BAD_HR(hr);
+	CComPtr<ID3D11RenderTargetView> rtv;
+	hr = m_Device->CreateRenderTargetView(pDestination, nullptr, &rtv);
+	RETURN_ON_BAD_HR(hr);
+
+	TONEMAP_PARAMS params{};
+	params.SdrScale = 80.0f / max(display.SdrWhiteNits, 1.0f);
+	params.Peak = max(display.MaxLuminanceNits / max(display.SdrWhiteNits, 1.0f), 1.2f);
+	params.Knee = 0.85f;
+	m_DeviceContext->UpdateSubresource(m_ParamsBuffer, 0, nullptr, &params, 0, 0);
+
+	VERTEX vertices[] =
+	{
+		{ XMFLOAT3(-1.0f, -1.0f, 0), XMFLOAT2(0.0f, 1.0f) },
+		{ XMFLOAT3(-1.0f, 1.0f, 0), XMFLOAT2(0.0f, 0.0f) },
+		{ XMFLOAT3(1.0f, -1.0f, 0), XMFLOAT2(1.0f, 1.0f) },
+		{ XMFLOAT3(1.0f, -1.0f, 0), XMFLOAT2(1.0f, 1.0f) },
+		{ XMFLOAT3(-1.0f, 1.0f, 0), XMFLOAT2(0.0f, 0.0f) },
+		{ XMFLOAT3(1.0f, 1.0f, 0), XMFLOAT2(1.0f, 0.0f) },
+	};
+	D3D11_BUFFER_DESC vertexDesc{};
+	vertexDesc.Usage = D3D11_USAGE_DEFAULT;
+	vertexDesc.ByteWidth = sizeof(vertices);
+	vertexDesc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+	D3D11_SUBRESOURCE_DATA vertexData{};
+	vertexData.pSysMem = vertices;
+	CComPtr<ID3D11Buffer> vertexBuffer;
+	hr = m_Device->CreateBuffer(&vertexDesc, &vertexData, &vertexBuffer);
+	RETURN_ON_BAD_HR(hr);
+
+	D3D11_VIEWPORT previousViewport{};
+	UINT viewportCount = 1;
+	m_DeviceContext->RSGetViewports(&viewportCount, &previousViewport);
+	SetViewPort(m_DeviceContext, static_cast<float>(width), static_cast<float>(height), static_cast<float>(sourceRegion.left), static_cast<float>(sourceRegion.top));
+
+	UINT stride = sizeof(VERTEX);
+	UINT offset = 0;
+	ID3D11Buffer *vertexBuffers[] = { vertexBuffer };
+	ID3D11RenderTargetView *targets[] = { rtv };
+	ID3D11ShaderResourceView *resources[] = { srv };
+	ID3D11Buffer *constants[] = { m_ParamsBuffer };
+	m_DeviceContext->IASetInputLayout(m_InputLayout);
+	m_DeviceContext->IASetVertexBuffers(0, 1, vertexBuffers, &stride, &offset);
+	m_DeviceContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+	m_DeviceContext->OMSetBlendState(nullptr, nullptr, 0xFFFFFFFF);
+	m_DeviceContext->OMSetRenderTargets(1, targets, nullptr);
+	m_DeviceContext->VSSetShader(m_VertexShader, nullptr, 0);
+	m_DeviceContext->PSSetShader(m_PixelShader, nullptr, 0);
+	m_DeviceContext->PSSetConstantBuffers(0, 1, constants);
+	m_DeviceContext->PSSetShaderResources(0, 1, resources);
+	m_DeviceContext->PSSetSamplers(0, 1, &m_Sampler);
+	m_DeviceContext->Draw(ARRAYSIZE(vertices), 0);
+
+	ID3D11ShaderResourceView *nullResources[] = { nullptr };
+	ID3D11RenderTargetView *nullTargets[] = { nullptr };
+	m_DeviceContext->PSSetShaderResources(0, 1, nullResources);
+	m_DeviceContext->OMSetRenderTargets(1, nullTargets, nullptr);
+	if (viewportCount > 0) {
+		m_DeviceContext->RSSetViewports(1, &previousViewport);
+	}
+	return S_OK;
+}
