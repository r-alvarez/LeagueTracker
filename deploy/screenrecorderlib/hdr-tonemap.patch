@@ -0,0 +1,54 @@
+#pragma once
+#include <d3d11.h>
+#include <dxgi1_6.h>
+#include <windows.h>
+
+// The colour state of one display, as far as an 8-bit capture cares: whether
+// the desktop is composited in HDR (scRGB), where Windows puts SDR white on it,
+// and how bright it can go.
+struct DISPLAY_HDR_INFO
+{
+	bool IsHdr = false;
+	float SdrWhiteNits = 80.0f;
+	float MaxLuminanceNits = 1000.0f;
+};
+
+// HDR state of the display that owns the monitor handle. Never fails: an
+// unknown display reads as SDR, which is the pre-existing behaviour.
+DISPLAY_HDR_INFO GetDisplayHdrInfo(_In_ HMONITOR monitor);
+
+// Set SCREENRECORDERLIB_HDR_TONEMAP=0 in the process environment to force
+// the plain 8-bit capture on HDR displays (kill switch for a host app).
+bool IsHdrToneMappingEnabled();
+
+// Draws an scRGB FP16 texture into a B8G8R8A8_UNORM texture through the
+// HdrToneMap pixel shader.
+class HdrToneMapper
+{
+public:
+	HdrToneMapper();
+	~HdrToneMapper();
+	HRESULT Initialize(_In_ ID3D11DeviceContext *pDeviceContext, _In_ ID3D11Device *pDevice);
+	// Converts sourceRegion of pSource (R16G16B16A16_FLOAT, scRGB) into the
+	// same region of pDestination (B8G8R8A8_UNORM, must be bindable as a
+	// render target). Both textures must be at least as large as the region.
+	HRESULT Convert(_In_ ID3D11Texture2D *pSource, _Inout_ ID3D11Texture2D *pDestination, _In_ D3D11_BOX sourceRegion, _In_ DISPLAY_HDR_INFO display);
+private:
+	struct TONEMAP_PARAMS
+	{
+		float SdrScale;
+		float Peak;
+		float Knee;
+		float Padding;
+	};
+	void CleanRefs();
+
+	ID3D11Device *m_Device;
+	ID3D11DeviceContext *m_DeviceContext;
+	ID3D11VertexShader *m_VertexShader;
+	ID3D11PixelShader *m_PixelShader;
+	ID3D11InputLayout *m_InputLayout;
+	ID3D11SamplerState *m_Sampler;
+	ID3D11Buffer *m_ParamsBuffer;
+	ID3D11Texture2D *m_SourceCopy;
+};
diff -ruN -x '*.user' -x .vs a/ScreenRecorderLibNative/HdrToneMapShader.hlsl b/ScreenRecorderLibNative/HdrToneMapShader.hlsl
--- a/ScreenRecorderLibNative/HdrToneMapShader.hlsl	1970-01-01 00:00:00.000000000 +0000
+++ b/ScreenRecorderLibNative/HdrToneMapShader.hlsl	2026-08-18 07:32:55.799446100 +0100
@@ -0,0 +1,57 @@
+// HDR desktop (scRGB FP16, linear light, BT.709 primaries, 1.0 = 80 nits) to
+// SDR sRGB 8-bit. Windows scales SDR content on an HDR desktop by the SDR
+// white level, so dividing by it puts every SDR pixel back where the app drew
+// it, and the sRGB curve returns the exact 8-bit values it had. Only content
+// above SDR white (Auto HDR / RTX HDR / native HDR highlights) is touched:
+// an extended-Reinhard roll-off from the knee up to the display's peak,
+// driven by max(R,G,B) so hue is kept, instead of the clip an 8-bit capture
+// would do. The knee sits at 0.85, so SDR white lands at ~246/255 - the
+// price of not clipping, and invisible next to what a clip does.
+
+Texture2D tx : register(t0);
+SamplerState samLinear : register(s0);
+
+cbuffer ToneMapParams : register(b0)
+{
+	float SdrScale;   // 80 / SDR white nits: scRGB -> SDR-relative linear
+	float Peak;       // display peak in SDR-white units (>= 1.2)
+	float Knee;       // roll-off start in SDR-relative linear (0.85)
+	float Padding;
+};
+
+struct PS_INPUT
+{
+	float4 Pos : SV_POSITION;
+	float2 Tex : TEXCOORD;
+};
+
+float RollOff(float m)
+{
+	// Extended Reinhard between the knee and the peak, both rescaled so the
+	// knee is 0 and SDR white is 1: unit slope at the knee (no visible seam),
+	// exactly 1.0 at the display peak, monotone in between.
+	float span = 1.0 - Knee;
+	float x = (m - Knee) / span;
+	float p = max((Peak - Knee) / span, 1.0);
+	float f = x * (1.0 + x / (p * p)) / (1.0 + x);
+	return Knee + span * min(f, 1.0);
+}
+
+float3 LinearToSrgb(float3 c)
+{
+	float3 lo = c * 12.92;
+	float3 hi = 1.055 * pow(max(c, 0.0), 1.0 / 2.4) - 0.055;
+	return c <= 0.0031308 ? lo : hi;
+}
+
+float4 PS(PS_INPUT input) : SV_Target
+{
+	float4 sample = tx.Sample(samLinear, input.Tex);
+	float3 rgb = max(sample.rgb, 0.0) * SdrScale;
+	float m = max(rgb.r, max(rgb.g, rgb.b));
+	if (m > Knee)
+	{
+		rgb *= RollOff(m) / m;
+	}
+	return float4(LinearToSrgb(saturate(rgb)), 1.0);
+}
