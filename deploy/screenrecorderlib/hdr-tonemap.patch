+HRESULT WindowsGraphicsCapture::CopyFrameToTexture(_In_ ID3D11Texture2D *pSurfaceTexture, _Inout_ ID3D11Texture2D *pFrame, _In_ D3D11_BOX sourceRegion)
+{
+	D3D11_TEXTURE2D_DESC surfaceDesc{};
+	pSurfaceTexture->GetDesc(&surfaceDesc);
+	if (surfaceDesc.Format == DXGI_FORMAT_R16G16B16A16_FLOAT && m_ToneMapper) {
+		return m_ToneMapper->Convert(pSurfaceTexture, pFrame, sourceRegion, m_DisplayHdr);
+	}
+	m_DeviceContext->CopySubresourceRegion(pFrame, 0, 0, 0, 0, pSurfaceTexture, 0, &sourceRegion);
+	return S_OK;
+}
