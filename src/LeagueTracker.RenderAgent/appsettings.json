{
  // Where the LeagueTracker server(s) live (the Docker host). From the gaming
  // PC use the tracker machine's LAN address. Multiple accounts = multiple
  // instances, comma-separated: "http://192.168.1.50:5170,http://192.168.1.50:5171".
  "ServerUrl": "http://localhost:5170,http://localhost:5171",

  // Blank = auto-detect (<drive>:\Riot Games\League of Legends on every drive).
  "LeaguePath": "",

  // Blank = "ffmpeg" from PATH, falling back to ffmpeg.exe next to this exe.
  "FfmpegPath": "",

  "AgentName": "",
  "PollSeconds": 60,
  "CaptureFramerate": 30,

  // Live-game recording (Ascent-style auto-VOD): while you are in a real
  // game, the game window is captured to an mp4 (NVENC) with a sidecar json
  // (match id, clock map) for review. Blank RecordingsDir = <My Videos>\LeagueTracker.
  "RecordGames": true,
  // Turn archived replays into clips. false = recorder-only (a friend's
  // gaming PC); true with RecordGames false = the dedicated render box.
  // Never true on two agents that share one machine.
  "RenderReplays": true,
  "RecordingsDir": "",
  // In-progress segments are written here first (blank = LocalAppData on the
  // system drive) and only the finished file moves to RecordingsDir. Keep it
  // on an SSD - a stalling recordings drive shows up as frozen frames.
  "RecordScratchDir": "",
  "RecordFramerate": 60,
  "RecordQuality": 26,
  // Game audio only (process loopback - Discord/music never captured).
  "RecordAudio": true,
  // Capture engine: "wgc" (Windows Graphics Capture; exclusive-fullscreen
  // mode switches can't interrupt it) or "ddagrab" (ffmpeg Desktop
  // Duplication + NVENC; dies on those switches - absorbed as a segment seam).
  "CaptureBackend": "wgc",
  // Non-blank = YouTube-ready names: "{prefix} - 22 Jul 2026 - Game 2".
  "RecordNamePrefix": "",
  // Send VODs to the tracker for the in-app review player. Off = local only.
  "UploadVods": true,
  // Send only the small review data (telemetry/metadata/thumbnail) so the
  // match page can overlay markers + APM on a linked YouTube upload.
  "UploadVodSidecars": true,
  // Which queues to record: ranked-solo, ranked-flex, normal, aram, clash,
  // coop-ai, urf, nexus-blitz, arena, brawl, doom-bots, custom, or all.
  "RecordQueues": "ranked-solo,normal",

  // Publish finished recordings to YouTube (resumable, pauses while a game
  // runs) and register the link with the owning tracker automatically.
  // Normally left OUT of this file: the tracker's agent profile supplies
  // YouTubeUpload, the OAuth client and the channel's refresh token (any key
  // written here wins over the profile). Only the machine that authorizes
  // the channel sets the client here and runs --youtube-auth once.
  // "YouTubeUpload": false,
  // "YouTubeClientId": "",
  // "YouTubeClientSecret": "",
  // "YouTubeVisibility": "unlisted",   // unlisted (default), private, public

  // Cloudflare Access service token (Zero Trust > Access > Service Auth) for
  // trackers behind an Access wall. Blank = no Access (dev against localhost).
  "CfAccessClientId": "",
  "CfAccessClientSecret": "",

  // 0 = render every planned window. Set to 1 for a quick smoke test.
  "MaxWindowsPerJob": 0
}
