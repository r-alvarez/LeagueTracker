<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window - the agent runs invisibly at logon and
         writes agent.log next to the exe instead. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WinForms only for the tray icon (NotifyIcon) and the install message box. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- deploy/publish-agent.ps1 stamps the real version (yyyy.M.d.HHmm);
         a dev build is 0.0.0.0 and never self-updates over a published one. -->
    <Version Condition="'$(Version)' == ''">0.0.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LeagueTracker.RenderAgent</RootNamespace>
    <!-- Published as one file so the gaming PC only needs the exe + appsettings. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- ScreenRecorderLib (WGC capture backend) is C++/CLI - AnyCPU can't
         load it; the agent is win-x64-only regardless. -->
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
  </ItemGroup>

  <!-- ScreenRecorderLib is a mixed-mode (C++/CLI) image: it cannot load out
       of a single-file bundle (BadImageFormatException) and must ship as a
       loose dll next to the exe - deploys copy it alongside. -->
  <Target Name="KeepMixedModeAssembliesLoose" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'ScreenRecorderLib.dll'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
