<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window - the agent runs invisibly at logon and
         writes agent.log next to the exe instead. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- deploy/publish-agent.ps1 stamps the real version (yyyy.Mdd.HHmm.ss)
         (UTC, to the second); a dev build is 0.0.0.0 and never self-updates over a published one. -->
    <Version Condition="'$(Version)' == ''">0.0.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LeagueTracker.RenderAgent</RootNamespace>
    <!-- Published as one file so the gaming PC only needs the exe + appsettings. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- ScreenRecorderLib (WGC capture backend) is C++/CLI - AnyCPU can't
         load it; the agent is win-x64-only regardless. -->
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ships next to the exe: the zip bundles GPL ffmpeg and a modified MIT
         library, and their notices travel with them. -->
    <None Update="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The site's favicon, rasterized: exe icon and the tray icon's base. -->
    <EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LeagueTracker.RenderAgent.Tests" />
    <InternalsVisibleTo Include="LeagueTracker.ReviewSmoke" />
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Assets\review-ui.zip" LogicalName="review-ui.zip" Condition="Exists('Assets\review-ui.zip')" />
    <None Update="Assets\review-THIRD-PARTY-NOTICES.md" Link="review-THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireReviewAssets" BeforeTargets="Publish" Condition="'RequireReviewAssets' == 'true'">
    <Error Condition="!Exists('Assets\review-ui.zip')" Text="Build the desktop UI with deploy/build-review-ui.ps1 before publishing." />
  </Target>

  <!-- The SDK supplies WPF references as well; this host only uses WinForms. -->
  <Target Name="RemoveUnusedWebViewWpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Reference.Identity)').EndsWith('Microsoft.Web.WebView2.Wpf.dll'))" />
    </ItemGroup>
  </Target>

  <!-- ScreenRecorderLib is a mixed-mode (C++/CLI) image: it cannot load out
       of a single-file bundle (BadImageFormatException) and must ship as a
       loose dll next to the exe - deploys copy it alongside. -->
  <Target Name="KeepMixedModeAssembliesLoose" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'runtimes\win-x64\native\WebView2Loader.dll' Or '%(ResolvedFileToPublish.Filename)' == 'aspnetcorev2_inprocess'" />
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'ScreenRecorderLib.dll'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
